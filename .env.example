# Copy to .env (gitignored). Compose passes this file to both services.

# Static bearer tokens. Leave both empty to disable auth, which
# the control plane only accepts on a loopback bind.
RTLFARM_CLIENT_TOKEN=
RTLFARM_WORKER_TOKEN=

# The toolchain digest the control plane pins jobs to;
# `rtlfarm dev pin-toolchain` writes it here.
RTLFARM_TOOLCHAIN__DIGEST=

# Any configuration key can be set here: RTLFARM_<KEY> for a top-level key,
# RTLFARM_<SECTION>__<KEY> for a key inside a section.
# RTLFARM_TIMING__LEASE_TTL_S=30
